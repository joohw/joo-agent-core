# joo-agent-core / @mariozechner/pi-ai
# 复制为 .env 后按需填写。运行 `npm run example` 时会通过 dotenv 自动加载本文件。
#
# --- 示例 `test/example.ts`（仅 Kimi For Coding）---
# 密钥须来自 Kimi For Coding（请求走 api.kimi.com/coding）。
# 若你只有 Moonshot 开放平台（api.moonshot.cn）的 key，与这里不是同一套，需到 Kimi For Coding 控制台单独开通/复制。
KIMI_API_KEY=

# --- 其他 provider（自建应用时自行 getModel + 设置对应变量）---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# 完整列表见 node_modules/@mariozechner/pi-ai/README.md → Environment Variables

# --- 可选 ---
# PI_CACHE_RETENTION=long
